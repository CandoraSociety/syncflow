  "automations": [
    {
      "name": "90-Day Follow-Up Reminder",
      "type": "scheduled",
      "function": "followupReminder",
      "schedule": {
        "repeat_interval": 1,
        "repeat_unit": "days",
        "start_time": "09:00"
      },
      "description": "Send email reminders for 90-day follow-ups due in 7, 3, and 0 days"
    },
    {
      "name": "Alert Email Notification",
      "type": "entity",
      "entity": "Client",
      "events": ["update"],
      "function": "sendAlertEmail",
      "description": "Send email alerts for placements, referrals, and barriers"
    }
