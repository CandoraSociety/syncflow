{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "Province"
    },
    "zip": {
      "type": "string",
      "description": "Postal code"
    },
    "compass_hsid": {
      "type": "string",
      "description": "Compass HSID# (Government of Alberta database)"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self",
        "family_friend",
        "school",
        "employer",
        "external_agency",
        "alberta_works",
        "other"
      ],
      "description": "How the client was referred"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "direct_to_employment",
        "pathways",
        "casual",
        "external_referral",
        "internal_referral",
        "not_eligible"
      ],
      "description": "Service Element (Stream)"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the assigned worker"
    },
    "assigned_worker_name": {
      "type": "string",
      "description": "Display name of the assigned worker"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "pending",
        "closed"
      ],
      "default": "new",
      "description": "Case status"
    },
    "intake_notes": {
      "type": "string",
      "description": "Notes from intake worker"
    },
    "intake_date": {
      "type": "string",
      "format": "date",
      "description": "Date of intake"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}