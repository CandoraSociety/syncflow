{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "Province"
    },
    "zip": {
      "type": "string",
      "description": "Postal code"
    },
    "compass_hsid": {
      "type": "string",
      "description": "Compass HSID# (Government of Alberta database)"
    },
    "compass_verified": {
      "type": "boolean",
      "description": "Client file entered into Compass"
    },
    "compass_verified_date": {
      "type": "string",
      "format": "date",
      "description": "Date Compass entry was verified"
    },
    "compass_verified_by": {
      "type": "string",
      "description": "Name of person who verified Compass entry"
    },
    "compass_notes": {
      "type": "string",
      "description": "Notes about Compass entry / discrepancies"
    },
    "residency_status": {
      "type": "string",
      "enum": [
        "canadian_citizen",
        "permanent_resident",
        "protected_person",
        "convention_refugee",
        "refugee_claimant",
        "temporary_resident",
        "work_permit",
        "study_permit",
        "visitor",
        "other"
      ],
      "description": "Canadian residency/immigration status"
    },
    "clb_level": {
      "type": "string",
      "enum": [
        "clb_1",
        "clb_2",
        "clb_3",
        "clb_4",
        "clb_5",
        "clb_6",
        "clb_7",
        "clb_8",
        "clb_9",
        "clb_10",
        "clb_11",
        "clb_12",
        "native_english_french"
      ],
      "description": "Canadian Language Benchmark level"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "E-RF",
        "E-UF",
        "E-PT",
        "UE",
        "UE-LA",
        "UE-S",
        "NA"
      ],
      "description": "Current employment status code"
    },
    "has_vehicle": {
      "type": "string",
      "enum": [
        "yes",
        "no_has_license",
        "no_no_license"
      ],
      "description": "Vehicle and driver's license status"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self",
        "family_friend",
        "school",
        "employer",
        "external_agency",
        "alberta_works",
        "other"
      ],
      "description": "How the client was referred"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "direct_to_employment",
        "pathways",
        "casual",
        "external_referral",
        "internal_referral",
        "not_eligible"
      ],
      "description": "Service Element (Stream)"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the assigned worker"
    },
    "assigned_worker_name": {
      "type": "string",
      "description": "Display name of the assigned worker"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "pending",
        "closed"
      ],
      "default": "new",
      "description": "Case status"
    },
    "program_status": {
      "type": "string",
      "enum": [
        "in_progress",
        "complete",
        "incomplete",
        "cancelled"
      ],
      "description": "Program completion status"
    },
    "file_closed": {
      "type": "boolean",
      "description": "Whether the file has been closed"
    },
    "closed_reason": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "incomplete",
        "withdrew",
        "relocated",
        "no_longer_eligible",
        "no_contact",
        "duplicate",
        "other"
      ],
      "description": "Reason the file was closed"
    },
    "closed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the file was closed"
    },
    "closed_notes": {
      "type": "string",
      "description": "Notes about why the file was closed"
    },
    "service_start_date": {
      "type": "string",
      "format": "date",
      "description": "Service start date"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Program completion date"
    },
    "employment_start_date": {
      "type": "string",
      "format": "date",
      "description": "Employment start date"
    },
    "post_completion_employment_status": {
      "type": "string",
      "enum": [
        "E-RF",
        "E-UF",
        "E-PT",
        "UE",
        "UE-LA",
        "UE-S",
        "NA",
        "no_contact"
      ],
      "description": "Employment status at post-program completion"
    },
    "post_completion_employment_date": {
      "type": "string",
      "format": "date"
    },
    "followup_90day_date": {
      "type": "string",
      "format": "date",
      "description": "90-day follow-up date"
    },
    "followup_90day_status": {
      "type": "string",
      "enum": [
        "E-RF",
        "E-UF",
        "E-PT",
        "UE",
        "UE-LA",
        "UE-S",
        "NA",
        "no_contact"
      ],
      "description": "90-day follow-up employment status code"
    },
    "service_navigation_supports": {
      "type": "boolean",
      "description": "Received service navigation supports"
    },
    "service_navigation_date": {
      "type": "string",
      "format": "date"
    },
    "barriers_addressed": {
      "type": "boolean",
      "description": "Barriers identified via BIT"
    },
    "bit_completed": {
      "type": "boolean",
      "description": "BIT step has been completed"
    },
    "bit_review_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "BIT Action Plan review dates (up to 4)"
    },
    "bit_checkin_frequency": {
      "type": "string",
      "description": "BIT check-in frequency"
    },
    "barrier_action_plan_completed": {
      "type": "boolean",
      "description": "Barrier Action Plan completed"
    },
    "action_plan_submitted": {
      "type": "boolean",
      "description": "Employment Action Plan submitted"
    },
    "action_plan_compass_entered": {
      "type": "boolean",
      "description": "Employment Action Plan has been entered into Compass"
    },
    "barrier_1": {
      "type": "string",
      "description": "Primary barrier type"
    },
    "barrier_1_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ]
    },
    "barrier_1_other": {
      "type": "string",
      "description": "Custom description if barrier_1 is Other"
    },
    "barrier_1_notes": {
      "type": "string"
    },
    "barrier_1_action_steps": {
      "type": "string"
    },
    "barrier_1_challenges": {
      "type": "string",
      "description": "Newline-separated selected challenges from BIT for barrier 1"
    },
    "barrier_1_timeline_start": {
      "type": "string",
      "format": "date"
    },
    "barrier_1_timeline_end": {
      "type": "string",
      "format": "date"
    },
    "barrier_1_responsible": {
      "type": "string"
    },
    "barrier_1_resources": {
      "type": "string"
    },
    "barrier_2": {
      "type": "string",
      "description": "Secondary barrier type"
    },
    "barrier_2_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ]
    },
    "barrier_2_other": {
      "type": "string"
    },
    "barrier_2_notes": {
      "type": "string"
    },
    "barrier_2_action_steps": {
      "type": "string"
    },
    "barrier_2_challenges": {
      "type": "string",
      "description": "Newline-separated selected challenges from BIT for barrier 2"
    },
    "barrier_2_timeline_start": {
      "type": "string",
      "format": "date"
    },
    "barrier_2_timeline_end": {
      "type": "string",
      "format": "date"
    },
    "barrier_2_responsible": {
      "type": "string"
    },
    "barrier_2_resources": {
      "type": "string"
    },
    "barrier_3": {
      "type": "string",
      "description": "Tertiary barrier type"
    },
    "barrier_3_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ]
    },
    "barrier_3_other": {
      "type": "string"
    },
    "barrier_3_notes": {
      "type": "string"
    },
    "barrier_3_action_steps": {
      "type": "string"
    },
    "barrier_3_challenges": {
      "type": "string",
      "description": "Newline-separated selected challenges from BIT for barrier 3"
    },
    "barrier_3_timeline_start": {
      "type": "string",
      "format": "date"
    },
    "barrier_3_timeline_end": {
      "type": "string",
      "format": "date"
    },
    "barrier_3_responsible": {
      "type": "string"
    },
    "barrier_3_resources": {
      "type": "string"
    },
    "exposure_course": {
      "type": "boolean"
    },
    "paid_external_placement": {
      "type": "boolean"
    },
    "employment_supports": {
      "type": "boolean"
    },
    "internal_placement": {
      "type": "string",
      "enum": [
        "none",
        "cleaning_arc",
        "food_services_onsite",
        "food_services_offsite",
        "reception",
        "childcare"
      ]
    },
    "internal_placement_details": {
      "type": "string"
    },
    "placement_start_date": {
      "type": "string",
      "format": "date"
    },
    "placement_end_date": {
      "type": "string",
      "format": "date"
    },
    "placement_supervisor": {
      "type": "string"
    },
    "placement_schedule": {
      "type": "string"
    },
    "placement_request_sent": {
      "type": "boolean",
      "description": "Whether placement request email has been sent"
    },
    "external_employer": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "employer_contact": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "job_start_date": {
      "type": "string",
      "format": "date"
    },
    "job_wage": {
      "type": "string"
    },
    "job_hours": {
      "type": "string"
    },
    "sdp_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sdp_item_details": {
      "type": "object",
      "description": "Per-item goals, timelines, notes for action plan"
    },
    "sdp_other_desc": {
      "type": "string",
      "description": "Description for 'other' action plan item"
    },
    "sdp_notes": {
      "type": "string"
    },
    "internal_referrals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_referrals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "career_objectives": {
      "type": "string"
    },
    "employment_history": {
      "type": "string"
    },
    "resume_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intake_notes": {
      "type": "string"
    },
    "intake_date": {
      "type": "string",
      "format": "date"
    },
    "program_stream_switches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_stream": {
            "type": "string"
          },
          "to_stream": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "reason_other": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "roadmap_item_status": {
      "type": "object",
      "description": "Per-item status tracking: { [itemId]: { status: 'planned'|'started'|'completed', started_date, completed_date, case_manager_notes } }"
    },
    "roadmap_progress_notes": {
      "type": "array",
      "description": "Auto-generated client progress status notes from roadmap events",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "description": "added|started|completed|dates_set"
          },
          "item_label": {
            "type": "string"
          },
          "item_key": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "logged_by": {
            "type": "string"
          },
          "logged_by_name": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}