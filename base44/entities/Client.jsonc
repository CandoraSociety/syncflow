{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "Province"
    },
    "zip": {
      "type": "string",
      "description": "Postal code"
    },
    "compass_hsid": {
      "type": "string",
      "description": "Compass HSID# (Government of Alberta database)"
    },
    "residency_status": {
      "type": "string",
      "enum": [
        "canadian_citizen",
        "permanent_resident",
        "protected_person",
        "convention_refugee",
        "refugee_claimant",
        "temporary_resident",
        "work_permit",
        "study_permit",
        "visitor",
        "other"
      ],
      "description": "Canadian residency/immigration status"
    },
    "clb_level": {
      "type": "string",
      "enum": [
        "clb_1",
        "clb_2",
        "clb_3",
        "clb_4",
        "clb_5",
        "clb_6",
        "clb_7",
        "clb_8",
        "clb_9",
        "clb_10",
        "clb_11",
        "clb_12",
        "native_english_french"
      ],
      "description": "Canadian Language Benchmark level"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "E-RF",
        "E-UF",
        "E-PT",
        "UE",
        "UE-LA",
        "UE-S",
        "NA"
      ],
      "description": "Current employment status code"
    },
    "has_vehicle": {
      "type": "string",
      "enum": [
        "yes",
        "no_has_license",
        "no_no_license"
      ],
      "description": "Vehicle and driver's license status"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self",
        "family_friend",
        "school",
        "employer",
        "external_agency",
        "alberta_works",
        "other"
      ],
      "description": "How the client was referred"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "direct_to_employment",
        "pathways",
        "casual",
        "external_referral",
        "internal_referral",
        "not_eligible"
      ],
      "description": "Service Element (Stream)"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the assigned worker"
    },
    "assigned_worker_name": {
      "type": "string",
      "description": "Display name of the assigned worker"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "pending",
        "closed"
      ],
      "default": "new",
      "description": "Case status"
    },
    "program_status": {
      "type": "string",
      "enum": [
        "in_progress",
        "complete",
        "incomplete",
        "cancelled"
      ],
      "description": "Program completion status"
    },
    "service_start_date": {
      "type": "string",
      "format": "date",
      "description": "Service start date"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Program completion date"
    },
    "employment_start_date": {
      "type": "string",
      "format": "date",
      "description": "Employment start date"
    },
    "followup_90day_date": {
      "type": "string",
      "format": "date",
      "description": "90-day follow-up date"
    },
    "followup_90day_status": {
      "type": "string",
      "enum": [
        "E-RF",
        "E-UF",
        "E-PT",
        "UE",
        "UE-LA",
        "UE-S",
        "NA",
        "no_contact"
      ],
      "description": "90-day follow-up employment status code"
    },
    "service_navigation_supports": {
      "type": "boolean",
      "description": "Received service navigation supports"
    },
    "service_navigation_date": {
      "type": "string",
      "format": "date",
      "description": "Service navigation date"
    },
    "barriers_addressed": {
      "type": "boolean",
      "description": "Barriers addressed in service plan"
    },
    "barrier_1": {
      "type": "string",
      "description": "Primary barrier"
    },
    "barrier_1_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ],
      "description": "Barrier 1 status"
    },
    "barrier_2": {
      "type": "string",
      "description": "Secondary barrier"
    },
    "barrier_2_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ],
      "description": "Barrier 2 status"
    },
    "barrier_3": {
      "type": "string",
      "description": "Tertiary barrier"
    },
    "barrier_3_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "in_progress",
        "resolved"
      ],
      "description": "Barrier 3 status"
    },
    "exposure_course": {
      "type": "boolean",
      "description": "Client did exposure course"
    },
    "paid_external_placement": {
      "type": "boolean",
      "description": "Client did paid external placement"
    },
    "employment_supports": {
      "type": "boolean",
      "description": "Client received employment supports (PPE etc)"
    },
    "internal_placement": {
      "type": "string",
      "enum": [
        "none",
        "cleaning_arc",
        "food_services_onsite",
        "food_services_offsite",
        "reception",
        "childcare"
      ],
      "description": "Internal placement type"
    },
    "internal_placement_details": {
      "type": "string",
      "description": "Internal placement job details, skills, description"
    },
    "external_employer": {
      "type": "string",
      "description": "External employer name (autocomplete)"
    },
    "employer_name": {
      "type": "string",
      "description": "Employer name when employed"
    },
    "employer_contact": {
      "type": "string",
      "description": "Employer contact info"
    },
    "job_title": {
      "type": "string",
      "description": "Job title when employed"
    },
    "job_start_date": {
      "type": "string",
      "format": "date",
      "description": "Job start date"
    },
    "job_wage": {
      "type": "string",
      "description": "Hourly wage or salary"
    },
    "job_hours": {
      "type": "string",
      "description": "Hours per week"
    },
    "sdp_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service Delivery Plan selected items"
    },
    "sdp_notes": {
      "type": "string",
      "description": "Service Delivery Plan additional notes"
    },
    "internal_referrals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal referrals made"
    },
    "external_referrals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External referrals made"
    },
    "career_objectives": {
      "type": "string",
      "description": "Career/Employment Objectives"
    },
    "employment_history": {
      "type": "string",
      "description": "Employment History / Education"
    },
    "resume_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded resume file URLs"
    },
    "intake_notes": {
      "type": "string",
      "description": "Notes from intake worker"
    },
    "intake_date": {
      "type": "string",
      "format": "date",
      "description": "Date of intake"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}