{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "Province"
    },
    "zip": {
      "type": "string",
      "description": "Postal code"
    },
    "compass_hsid": {
      "type": "string",
      "description": "Compass HSID# (Government of Alberta database)"
    },
    "residency_status": {
      "type": "string",
      "enum": [
        "canadian_citizen",
        "permanent_resident",
        "protected_person",
        "convention_refugee",
        "refugee_claimant",
        "temporary_resident",
        "work_permit",
        "study_permit",
        "visitor",
        "other"
      ],
      "description": "Canadian residency/immigration status"
    },
    "clb_level": {
      "type": "string",
      "enum": [
        "clb_1",
        "clb_2",
        "clb_3",
        "clb_4",
        "clb_5",
        "clb_6",
        "clb_7",
        "clb_8",
        "clb_9",
        "clb_10",
        "clb_11",
        "clb_12",
        "native_english_french"
      ],
      "description": "Canadian Language Benchmark level"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "employed",
        "unemployed",
        "underemployed"
      ],
      "description": "Current employment status"
    },
    "has_vehicle": {
      "type": "string",
      "enum": [
        "yes",
        "no_has_license",
        "no_no_license"
      ],
      "description": "Vehicle and driver's license status"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self",
        "family_friend",
        "school",
        "employer",
        "external_agency",
        "alberta_works",
        "other"
      ],
      "description": "How the client was referred"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "direct_to_employment",
        "pathways",
        "casual",
        "external_referral",
        "internal_referral",
        "not_eligible"
      ],
      "description": "Service Element (Stream)"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the assigned worker"
    },
    "assigned_worker_name": {
      "type": "string",
      "description": "Display name of the assigned worker"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "pending",
        "closed"
      ],
      "default": "new",
      "description": "Case status"
    },
    "career_objectives": {
      "type": "string",
      "description": "Career/Employment Objectives"
    },
    "employment_history": {
      "type": "string",
      "description": "Employment History / Education"
    },
    "resume_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded resume file URLs"
    },
    "intake_notes": {
      "type": "string",
      "description": "Notes from intake worker"
    },
    "intake_date": {
      "type": "string",
      "format": "date",
      "description": "Date of intake"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}