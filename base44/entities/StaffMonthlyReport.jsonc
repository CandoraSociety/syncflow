{
  "name": "StaffMonthlyReport",
  "type": "object",
  "properties": {
    "report_month": {
      "type": "string",
      "format": "date",
      "description": "Month being reported (YYYY-MM format)"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of staff member submitting the report"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Name of staff member submitting the report"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "description": "Date the report was submitted"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "draft",
      "description": "Report status"
    },
    "trends": {
      "type": "string",
      "description": "Narrative on trends observed this month"
    },
    "marketing_activities": {
      "type": "string",
      "description": "Marketing and outreach activities conducted"
    },
    "success_stories": {
      "type": "string",
      "description": "Client success stories and achievements"
    },
    "employer_engagements": {
      "type": "string",
      "description": "Employer engagement activities and outcomes"
    },
    "challenges": {
      "type": "string",
      "description": "Challenges encountered and how they were addressed"
    },
    "goals_next_month": {
      "type": "string",
      "description": "Goals and priorities for the next month"
    },
    "additional_notes": {
      "type": "string",
      "description": "Any additional notes or comments"
    }
  },
  "required": [
    "report_month",
    "submitted_by"
  ]
}